# Lokale, netzwerkfreie Entwicklung (nicht fuer den Linux-Server verwenden)
APP_ENV=development
APP_NAME=Jobradar BW
APP_HOST=127.0.0.1
APP_PORT=8080
APP_BASE_URL=http://127.0.0.1:8080
DEFAULT_LOCALE=en
APP_SECRET_KEY=development-only-secret-change-before-production
SECURE_COOKIES=false
DATABASE_URL=sqlite:///./jobradar-dev.db


# Adzuna API - auf https://developer.adzuna.com registrieren
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Jooble API - Key auf https://jooble.org/api/about anfordern
JOOBLE_API_KEY=


# APIs/Feeds und Firecrawl bleiben ohne CRAWLING_ENABLED netzwerkstill.
# Firecrawl benoetigt zusaetzlich seine separate Freigabe im UI.
CRAWLING_ENABLED=false
CODEX_ENABLED=false
INSTALL_CODEX=false
NOTIFICATIONS_ENABLED=false

SYNC_INTERVAL_MINUTES=360
FIRECRAWL_SYNC_INTERVAL_MINUTES=120
BA_JOBS_ENABLED=true
FIRECRAWL_ENABLED=true
FIRECRAWL_BASE_URL=http://127.0.0.1:3002
FIRECRAWL_API_KEY=

# Speicherung
RAW_HTML_RETENTION_DAYS=90
JOB_INACTIVE_AFTER_DAYS=30
