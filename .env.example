# Anwendung
APP_ENV=production
APP_NAME=Jobradar BW
APP_HOST=127.0.0.1
APP_PORT=8080
APP_BASE_URL=http://127.0.0.1:8080
DEFAULT_LOCALE=en
APP_SECRET_KEY=BITTE-MIT-EINEM-LANGEN-ZUFAELLSWERT-ERSETZEN
SECURE_COOKIES=true
TZ=Europe/Berlin

# Datenbank (Docker Compose)
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=BITTE-ERSETZEN
DATABASE_URL=postgresql+psycopg://jobradar:BITTE-ERSETZEN@postgres:5432/jobradar

# Sicherheitsschalter: im ausgelieferten Zustand absichtlich AUS.
CRAWLING_ENABLED=false
CODEX_ENABLED=false
INSTALL_CODEX=false
NOTIFICATIONS_ENABLED=false

# Abrufe
SYNC_INTERVAL_MINUTES=360
FIRECRAWL_SYNC_INTERVAL_MINUTES=120
DEFAULT_REGION=Baden-Wuerttemberg
DEFAULT_EMPLOYMENT_SCOPE=full_time
DEFAULT_MAX_COMMUTE_MINUTES=75
DEFAULT_COMMUTE_DEVALUE_FROM_MINUTES=60

# Adzuna API - auf https://developer.adzuna.com registrieren
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Jooble API - Key auf https://jooble.org/api/about anfordern
JOOBLE_API_KEY=


# Quellen. API- und Feed-Abrufe starten erst, wenn CRAWLING_ENABLED=true
# UND der API-Schalter im UI aktiv ist. Firecrawl braucht zusaetzlich seine
# separate UI-Freigabe; FIRECRAWL_ENABLED allein autorisiert keinen Abruf.
BA_JOBS_ENABLED=true
FIRECRAWL_ENABLED=true
FIRECRAWL_BASE_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=

# ChatGPT-Plan ueber den Codex App Server. Keine OpenAI-API-Abrechnung als Standard.
CODEX_COMMAND=codex app-server
CODEX_MODEL=
CODEX_MAX_JOBS_PER_RUN=50
CODEX_MIN_REMAINING_PERCENT=20
CODEX_DATA_DIR=/data/codex-workspace

# Speicherung
RAW_HTML_RETENTION_DAYS=90
JOB_INACTIVE_AFTER_DAYS=30
