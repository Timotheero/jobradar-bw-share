# Firecrawl bindet nur an localhost. Jobradar erreicht die API ueber das Docker-Netz.
PORT=127.0.0.1:3002
INTERNAL_PORT=3002
HOST=0.0.0.0
USE_DB_AUTHENTICATION=false

# Vor dem Start ersetzen.
BULL_AUTH_KEY=BITTE-MIT-EINEM-LANGEN-ZUFAELLSWERT-ERSETZEN
POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=BITTE-ERSETZEN
# The current upstream pg_cron image initializes its queue schema in this database.
POSTGRES_DB=postgres

# Ohne externen LLM-Schluessel: Jobradar uebernimmt Extraktion und Bewertung selbst.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=

# Optionale Upstream-Integrationen bleiben fuer die lokale Jobradar-Instanz aus.
AUTUMN_SECRET_KEY=
SLACK_WEBHOOK_URL=
TEST_API_KEY=
SUPABASE_ANON_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_TOKEN=
SELF_HOSTED_WEBHOOK_URL=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=zapmeta,resulthunter,dogpile
SEARXNG_CATEGORIES=
NUQ_BACKEND=

# Konservative Ausgangswerte fuer einen Server mit 8 GB RAM.
NUQ_WORKER_COUNT=1
NUM_WORKERS_PER_QUEUE=1
CRAWL_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_JOBS=1
BROWSER_POOL_SIZE=1
MAX_CPU=0.85
MAX_RAM=0.85
LOGGING_LEVEL=info
ALLOW_LOCAL_WEBHOOKS=false
BLOCK_MEDIA=true
